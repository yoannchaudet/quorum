{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quorum",
  "version": "0.1.0",
  "identifier": "com.yoannchaudet.quorum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "title": "Quorum",
        "width": 1120,
        "height": 720,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "transparent": true,
        "theme": "Light",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 },
        "windowEffects": { "effects": ["sidebar"], "state": "active" }
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
